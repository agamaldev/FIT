// ============================================================================
//  قواعد أمان Firestore لموقع MAKE ME FIT
// ----------------------------------------------------------------------------
//  الصق هذا المحتوى في:
//    Firebase Console > Firestore Database > Rules  ثم اضغط "Publish".
//
//  المبدأ: كل مستخدم يقرأ ويكتب بياناته فقط (owner-only). لا يمكن لأي مستخدم
//  الوصول إلى بيانات مستخدم آخر، ولا يمكن للزوار غير المسجّلين قراءة أي شيء.
// ============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // مستند المستخدم: users/{uid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // سجل حاسبة السعرات: users/{uid}/calcHistory/{docId}
      match /calcHistory/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // سجل الوزن والقياسات: users/{uid}/weightLog/{docId}
      match /weightLog/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // سجل الصيام المتقطع: users/{uid}/fastingHistory/{docId}
      match /fastingHistory/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // رفض كل ما عدا ذلك افتراضياً
  }
}
