// ============================================================================
//  قواعد أمان Firebase Storage لموقع MAKE ME FIT
// ----------------------------------------------------------------------------
//  الصق هذا المحتوى في:
//    Firebase Console > Storage > Rules  ثم اضغط "Publish".
//  (تحتاج أولاً تفعيل Storage من Console > Storage > Get started.)
//
//  المبدأ: صورة كل مستخدم (avatars/{uid}) قابلة للقراءة للجميع (لعرضها في
//  القائمة والملف الشخصي)، لكن لا يكتبها/يستبدلها إلا صاحبها فقط.
// ============================================================================

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // صورة المستخدم الشخصية: avatars/{uid}
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // رفض كل ما عدا ذلك
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
